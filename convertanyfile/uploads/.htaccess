# Security Hardening: Prevent PHP script execution in uploaded file storage
# Disables PHP engine and treats all files as static downloads
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Block access to any executable scripts
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI
